#!/usr/bin/env bash
# Launches a Claude session in a new herdr tab and registers the tab, so the
# herdr-tidy Stop hook closes it once that session has ended.
# Usage: herdr-agent-tab <label> <cwd> <prompt-file>
set -uo pipefail

label=$1 cwd=$2 prompt=$3
[ -f "$prompt" ] || { echo "herdr-agent-tab: no prompt file $prompt" >&2; exit 2; }
workspace="${HERDR_WORKSPACE_ID:-${HERDR_TAB_ID%%:*}}"

# The session must start on a branch already visible on GitHub (rules/git.md).
branch=$(git -C "$cwd" symbolic-ref --short -q HEAD 2>/dev/null)
case "$branch" in
  ""|main|master|dev|develop) ;;
  *) [ "$(git -C "$cwd" rev-parse --abbrev-ref '@{u}' 2>/dev/null)" = "origin/$branch" ] ||
       git -C "$cwd" push -q -u origin "$branch" ||
       { echo "herdr-agent-tab: could not publish $branch" >&2; exit 1; } ;;
esac

created=$(herdr tab create ${workspace:+--workspace "$workspace"} --label "$label" --cwd "$cwd" --no-focus) || exit 1
tab=$(jq -r '.result.tab.tab_id' <<<"$created")
pane=$(jq -r '.result.root_pane.pane_id' <<<"$created")
echo "$tab" >> "$HOME/.claude/.herdr-agent-tabs"
herdr pane run "$pane" "claude --permission-mode bypassPermissions \"\$(cat '$prompt')\"" >/dev/null
# Wait until Claude is in front: until then the pane looks idle (a shell) and
# the herdr-tidy Stop hook would close the brand-new tab.
for _ in $(seq 1 30); do
  herdr pane process-info --pane "$pane" 2>/dev/null |
    jq -r '.result.process_info.foreground_processes[0].name // ""' 2>/dev/null |
    grep -qvE '^(zsh|bash|fish|sh|-zsh|-bash)?$' && break
  sleep 0.5
done
printf '{"tab":"%s","pane":"%s","label":"%s"}\n' "$tab" "$pane" "$label"
