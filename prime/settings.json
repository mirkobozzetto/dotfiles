{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "high",
  "bundledSkills": {
    "websearch": false
  },
  "skills": [
    "-skill-creator/SKILL.md"
  ],
  "hideThinkingBlock": true,
  "extensions": [
    "extensions/model-presets.ts",
    "extensions/work-modes.ts",
    "extensions/orchestration-modes.ts",
    "extensions/questionnaire.ts"
  ],
  "mcpServers": {
    "gitnexus": {
      "type": "stdio",
      "command": "gitnexus",
      "args": [
        "mcp"
      ],
      "startupTimeoutMs": 20000,
      "callTimeoutMs": 60000,
      "enabledTools": [
        "list_repos",
        "query",
        "context",
        "impact",
        "detect_changes",
        "cypher"
      ]
    },
    "exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa%2Cweb_fetch_exa%2Ccrawling_exa%2Cweb_search_advanced_exa%2Cget_code_context_exa%2Cdeep_search_exa",
      "bearerTokenEnvVar": "EXA_API_KEY",
      "startupTimeoutMs": 20000,
      "callTimeoutMs": 60000
    }
  }
}
