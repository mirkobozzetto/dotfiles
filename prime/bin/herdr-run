#!/usr/bin/env bash
# Run a command in a dedicated, unfocused Herdr tab and relay its result.
# Usage: herdr-run <cwd> <command>. Prime calls this through native bash().
# Job scripts, output and exit codes remain private under ~/.prime/agent/commands.
# Stopping this relay does not necessarily stop the command in its Herdr pane.

set -uo pipefail
umask 077

CWD="${1:-$PWD}"
CMD="${2:-}"
[ -n "$CMD" ] || { echo "usage: pane-run <cwd> <command>" >&2; exit 2; }

JOBS="$HOME/.prime/agent/commands"
mkdir -p "$JOBS"


run_local() {
  echo "[pane-run] $1, local execution"
  cd "$CWD" || exit 1
  eval "$CMD"
  exit $?
}

# --------------------------------------------------------------- herdr backend
HERDR_COMMAND_TAB_LABEL="Prime commands"

# A herdr pane is usable when its foreground process is a shell. Plugin overlays
# answer `pane_not_found` here, which excludes them without a special case.
herdr_is_shell() {
  herdr pane process-info --pane "$1" 2>/dev/null |
    jq -e -r '.result.process_info.foreground_processes[0].name // ""' 2>/dev/null |
    grep -qE '^(zsh|bash|fish|sh|-zsh|-bash)$'
}

herdr_reserve_shell() {
  mkdir "$JOBS/lease-$1" 2>/dev/null || return 1
  if herdr_is_shell "$1"; then return 0; fi
  rmdir "$JOBS/lease-$1" 2>/dev/null
  return 1
}

herdr_target() {
  local workspace memo remembered panes target="" candidates
  local id tab tab_ids created label memo_tab
  workspace="${HERDR_WORKSPACE_ID:-${HERDR_TAB_ID%%:*}}"
  [ -n "$workspace" ] || return 1
  memo="$JOBS/herdr-command-$workspace"

  tab_ids=$(herdr tab list --workspace "$workspace" 2>/dev/null |
    jq -r --arg label "$HERDR_COMMAND_TAB_LABEL" '
      .result.tabs[]
      | select(
          .label == $label
          or (.label | startswith($label + " "))
        )
      | .tab_id' 2>/dev/null)

  panes=$(herdr pane list --workspace "$workspace" 2>/dev/null)
  if [ -f "$memo" ]; then
    remembered=$(cat "$memo")
    memo_tab=$(printf '%s' "$panes" | jq -r --arg pane "$remembered" '
      [.result.panes[] | select(.pane_id == $pane) | .tab_id][0]
      // empty' 2>/dev/null)
    for tab in $tab_ids; do
      if [ "$tab" = "$memo_tab" ] && herdr_reserve_shell "$remembered"; then
        target="$remembered"
        break
      fi
    done
  fi

  if [ -z "$target" ]; then
    for tab in $tab_ids; do
      candidates=$(printf '%s' "$panes" | jq -r --arg tab "$tab" '
        .result.panes[]
        | select(.tab_id == $tab)
        | .pane_id' 2>/dev/null)
      for id in $candidates; do
        if herdr_reserve_shell "$id"; then
          target="$id"
          break 2
        fi
      done
    done
  fi

  # Never split a pane for agent commands. Busy commands get another tab.
  if [ -z "$target" ]; then
    label="$HERDR_COMMAND_TAB_LABEL"
    if [ -n "$tab_ids" ]; then
      label="$HERDR_COMMAND_TAB_LABEL $$"
    fi
    created=$(herdr tab create --workspace "$workspace" --cwd "$CWD" \
      --label "$label" --no-focus 2>/dev/null)
    tab=$(printf '%s' "$created" |
      jq -r '.result.tab.tab_id // empty' 2>/dev/null)
    [ -n "$tab" ] || return 1

    panes=$(herdr pane list --workspace "$workspace" 2>/dev/null)
    target=$(printf '%s' "$panes" | jq -r --arg tab "$tab" '
      [.result.panes[] | select(.tab_id == $tab) | .pane_id][0]
      // empty' 2>/dev/null)
    [ -n "$target" ] && mkdir "$JOBS/lease-$target" 2>/dev/null || return 1
  fi

  [ -n "$target" ] || return 1
  echo "$target" > "$memo"
  printf '%s' "$target"
}

herdr_send() {
  # Leading space, like the tmux path: keeps the job line out of the shell
  # history under HIST_IGNORE_SPACE. The pane still prints the real command.
  herdr pane run "$1" " bash '$2'" >/dev/null 2>&1
}

# ------------------------------------------------------------------- dispatch

if [ "${HERDR_ENV:-}" != "1" ] || [ -z "${HERDR_PANE_ID:-}" ]; then
  run_local "outside Herdr"
fi
command -v herdr >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || {
  echo "[herdr-run] herdr or jq unavailable; command not executed" >&2; exit 125;
}
backend="herdr"
target=$(herdr_target) || {
  echo "[herdr-run] no command tab available; command not executed" >&2; exit 125;
}

trap 'rmdir "$JOBS/lease-$target" 2>/dev/null || true' EXIT
id="$(date -u +%Y%m%dT%H%M%SZ)-$$-${RANDOM}"
job="$JOBS/$id.sh"
out="$JOBS/$id.out"
rc="$JOBS/$id.rc"

# The echoed command line stays outside the tee, so it shows in the pane
# without polluting the output handed back to the agent.
# The code is read from PIPESTATUS after the pipeline, not from an `echo $?`
# inside it: a command that calls `exit` itself kills that subshell, and the
# inner echo would never run, leaving the caller waiting for a file that never
# lands. `mv` runs once the pipe has finished, so `rc` appearing proves `tee`
# has flushed everything into `out`.
{
  printf 'cd %q || { echo 1 > %q; exit 1; }\n' "$CWD" "$rc"
  printf 'printf "\\033[1;36m$ %%s\\033[0m\\n" %q\n' "$CMD"
  printf '{\n%s\n} 2>&1 | tee %q\n' "$CMD" "$out"
  printf 'echo "${PIPESTATUS[0]}" > %q.tmp\n' "$rc"
  printf 'mv %q.tmp %q\n' "$rc" "$rc"
} > "$job"

printf '%s\n' "$target" > "$JOBS/$id.pane"
printf '[herdr-run] pane=%s history=%s\n' "$target" "$JOBS/$id"
herdr_send "$target" "$job" || {
  echo "[herdr-run] dispatch failed; command was not retried" >&2; exit 125;
}

limit=18000 # 1800s at 100ms per tick
ticks=0
while [ ! -f "$rc" ]; do
  ticks=$((ticks + 1))
  if [ "$ticks" -gt "$limit" ]; then
    cat "$out" 2>/dev/null
    echo "[pane-run] timed out after 1800s, still running in $backend pane $target" >&2
    exit 124
  fi
  sleep 0.1
done

cat "$out"
code=$(cat "$rc")
# Retain the command and result for user-visible history.
exit "${code:-0}"
