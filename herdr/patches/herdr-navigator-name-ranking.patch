+/// The fuzzy score ignores length, so "hop" ties with every long path that
+/// holds those letters. The entry name itself wins: exact, then prefix, then
+/// substring, the shorter name first inside each tier.
+fn name_rank(title: &str, query: &str) -> (u8, usize) {
+    if query.is_empty() {
+        return (3, 0);
+    }
+    let title = title.to_lowercase();
+    if title == query {
+        (0, 0)
+    } else if title.starts_with(query) {
+        (1, title.len())
+    } else if title.contains(query) {
+        (2, title.len())
+    } else {
+        (3, 0)
     }
 }
 
